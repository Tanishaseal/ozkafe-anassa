# Required on Vercel. Use the service role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=https://anassa.ozkafe.in

# Optional: real email OTP delivery
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-sender@example.com
# SMTP_PASS=your-app-password

# Test-only OTP preview is disabled unless explicitly enabled outside Vercel.
# ANASSA_TEST_OTP=1
